{
  "name": "ubnd-ttpvhcc-qr",
  "version": "1.10.0",
  "private": true,
  "description": "Hệ thống tra cứu thủ tục hành chính qua mã QR - Trung tâm Phục vụ hành chính công",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/them-csp.mjs",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "kiem-tra": "npm run typecheck && npm run lint && npm test",
    "du-lieu:trich-xuat": "python3 scripts/trich-xuat-du-lieu.py",
    "du-lieu:tao-qr": "python3 scripts/tao-ma-qr.py",
    "du-lieu:lam-moi": "npm run du-lieu:trich-xuat && npm run du-lieu:tao-qr",
    "kiem-tra-qr": "python3 scripts/kiem-tra-ma-qr.py",
    "kiem-tra-bo-chu": "python3 scripts/kiem-tra-bo-chu.py",
    "bo-chu:sinh-lai": "python3 scripts/tao-bo-chu.py",
    "kiem-tra-csp": "node scripts/kiem-tra-csp.mjs",
    "kiem-tra-phien-ban": "node scripts/kiem-tra-phien-ban.mjs",
    "kiem-tra-tro-nang": "node scripts/kiem-tra-tro-nang.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
